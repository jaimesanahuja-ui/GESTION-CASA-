# Copia este archivo a .env.local para probar la sincronización compartida en local
# con `vercel dev` (no con `npm run dev`, que no sirve /api).
# En producción, configura estas mismas variables en Vercel → Settings → Environment Variables.

# Cadena secreta que elijas tú. Debe ser EXACTAMENTE igual en las dos variables.
SYNC_TOKEN=
VITE_SYNC_TOKEN=

# Las rellena automáticamente Vercel al conectar una base de datos Redis (Upstash)
# desde la pestaña Storage del proyecto.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
